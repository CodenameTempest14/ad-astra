#!/usr/bin/env bash
# Ad Astra pre-push guard — HARD RULE SEC-13 (owner, 2026-10-29): everybody pushes ONLY to their own branch.
#
# Reads .githooks/branch-owners.txt (email=branch). Blocks:
#   - pushing to any branch other than the one owned by `git config user.email`
#     (this includes `main`: it changes only by a reviewed merge on GitHub)
#   - deleting a remote branch
#   - non-fast-forward (force) pushes
# Enable once per clone:   git config core.hooksPath .githooks
# Tags are not checked here (pushing a tag still needs the owner's approval, SEC-7).

root="$(git rev-parse --show-toplevel)"
email="$(git config user.email)"
allowed=""
while IFS='=' read -r owner_email owner_branch; do
  case "$owner_email" in ''|\#*) continue ;; esac
  [ "$owner_email" = "$email" ] && allowed="$owner_branch"
done < "$root/.githooks/branch-owners.txt"

if [ -z "$allowed" ]; then
  echo "pre-push: BLOCKED. git user.email '$email' is not listed in .githooks/branch-owners.txt." >&2
  echo "          Set yours with: git config user.email <your email>" >&2
  exit 1
fi

zero="0000000000000000000000000000000000000000"
input="$(cat)"        # keep the pushed refs: we read them twice (our checks, then Git LFS)
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  target="${remote_ref#refs/heads/}"
  if [ "$target" != "$allowed" ]; then
    echo "pre-push: BLOCKED. $email may push only to '$allowed' (this push targets '$target')." >&2
    exit 1
  fi
  if [ "$local_sha" = "$zero" ]; then
    echo "pre-push: BLOCKED. Deleting the remote branch '$target' is not allowed from here." >&2
    exit 1
  fi
  if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: BLOCKED. This would rewrite '$target' (non-fast-forward). Pull/rebase first; force-push is not allowed." >&2
    exit 1
  fi
done <<< "$input"

# Pointing core.hooksPath here REPLACES Git LFS's own pre-push hook, so chain to it: without this the
# design images (stored in LFS) are not uploaded and GitHub rejects the push ("pre-receive hook declined").
if command -v git-lfs >/dev/null 2>&1; then
  printf '%s\n' "$input" | git lfs pre-push "$@" || exit $?
fi
exit 0
