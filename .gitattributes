# Normalise line endings in the repo; Windows checkouts get CRLF where Git decides.
* text=auto

# Shell scripts (Claude Code hooks) must keep LF line endings or bash fails on Windows checkouts.
*.sh text eol=lf

# Design images are stored with Git LFS (Decision D-003) to keep clones small.
design/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*.ico filter=lfs diff=lfs merge=lfs -text

# Git hooks are bash scripts: keep LF endings on every platform.
.githooks/* text eol=lf
